# Use ONE Discord application/bot token for both welcome and ticket features.
DISCORD_TOKEN=YOUR_BOT_TOKEN
CLIENT_ID=YOUR_APPLICATION_ID
GUILD_ID=YOUR_DISCORD_SERVER_ID

# Welcome bot
WELCOME_CHANNEL_ID=YOUR_WELCOME_CHANNEL_ID

# Ticket bot
# Custom role IDs allowed to use ticket controls and post the panel (comma-separated).
# This is independent of Discord Administrator/Manage Server permissions.
TICKET_CONTROL_ROLE_IDS=YOUR_CUSTOM_STAFF_ROLE_ID
SUPPORT_ROLE_ID=YOUR_MAIN_SUPPORT_ROLE_ID
TICKET_LOG_CHANNEL_ID=YOUR_TRANSCRIPT_LOG_CHANNEL_ID
# Optional: parent category where ticket channels are created
TICKET_CATEGORY_ID=

# Optional category-specific roles; blank means SUPPORT_ROLE_ID is used
STAFF_APPLICATION_ROLE_ID=
ESPORTS_APPLICATION_ROLE_ID=
GENERAL_SUPPORT_ROLE_ID=
SPONSORSHIP_ROLE_ID=
BASE_ACCESS_ROLE_ID=
REPORT_PLAYER_ROLE_ID=

# Branding
BRAND_NAME=VYUH ESPORTS
PANEL_COLOR=F5C842
TICKET_COLOR=2F3136
DATABASE_PATH=./data/tickets.sqlite

# Role allowed to use /announce and giveaway create/end/delete/reroll (admins are also allowed)
ESPORTS_STAFF_ROLE_ID=YOUR_ESPORTS_STAFF_ROLE_ID
